# ================= Copy this file to .env (local) or add the same names in Vercel > Settings > Environment Variables =================

# 1) DEMO MODE
#    on  = sample farms, orders, prices and a filled-in owner login (good for trying the app)
#    off = a clean, empty system for real use. Sample data disappears automatically and the owner logs in with an OTP.
VITE_DEMO_MODE=on

# 2) CUSTOMER SIDE (customer login, customer account page, basket and online orders)
#    Leave it off for now: the public page then shows the farm, photos and prices, and tells visitors to call, WhatsApp or email to order.
#    Turn it on later with: on (or true / 1 / yes). Demo mode always has it on so you can test it.
VITE_CUSTOMER_MODE=off

# 3) FARM DETAILS (shown on the shop; you can also change them later in Settings)
VITE_FARM_NAME=Eggester
VITE_FARM_PHONE=
VITE_FARM_WHATSAPP=
VITE_FARM_EMAIL=Eggesterfarm@gmail.com
VITE_FARM_ADDRESS=            # optional written address. If you fill it, a map preview is shown
VITE_FARM_MAP_URL=https://share.google/WX5vdhi9jFhNZUybO

# 4) PAYMENTS (optional)
VITE_UPI_ID=
VITE_RAZORPAY_KEY_ID=

# 5) OWNER OTP LOGIN. Used when VITE_DEMO_MODE=off. Add these in Vercel only. These are SERVER settings:
#    they are never sent to the browser. Do not put them in a file you share or commit.
VITE_OTP_CHANNEL=email          # email or sms (this one is public and only decides which box the login page shows)
OTP_CHANNEL=email               # email or sms
OTP_SECRET=                     # 32+ random characters, e.g. run: openssl rand -hex 32
ADMIN_EMAIL=Eggesterfarm@gmail.com   # where the login code is sent (when OTP_CHANNEL=email)
RESEND_API_KEY=                 # from resend.com (email sending)
OTP_FROM_EMAIL=Eggester <onboarding@resend.dev>   # no domain yet? sign up at resend.com with Eggesterfarm@gmail.com; this test sender can email that same address. Later use your own domain.
ADMIN_PHONE=                    # the owner's 10-digit mobile (when OTP_CHANNEL=sms)
FAST2SMS_API_KEY=               # from fast2sms.com (SMS sending)
OTP_BRAND=Eggester
