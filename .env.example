# Copy to .env for local use. On Vercel: Project > Settings > Environment Variables.
# Everything is optional: the site works without any of these (demo mode).

# --- Farm details (phase 1) ---
VITE_FARM_NAME=Eggester
VITE_FARM_PHONE=+91 98765 43210
VITE_FARM_WHATSAPP=919876543210
VITE_FARM_EMAIL=hello@kesariyafarms.in
VITE_FARM_ADDRESS=Kesariya Road, East Champaran, Bihar 845438

# --- Owner dashboard ---
VITE_ADMIN_EMAIL=admin@kesariyafarms.in
VITE_ADMIN_PASSWORD=Admin@123
# Demo logins (demo customer + hint boxes). Set to false before going live.
VITE_SHOW_DEMO_LOGINS=true

# --- Delivery rules ---
VITE_DELIVERY_FEE=40
VITE_FREE_DELIVERY_ABOVE=500

# --- Payments (phase 2) ---
# Your UPI ID (e.g. farm@okhdfcbank). Leave empty to hide the UPI option.
VITE_UPI_ID=
# Razorpay Key ID (starts with rzp_). Leave empty to hide card/net-banking.
VITE_RAZORPAY_KEY_ID=

# --- Database (phase 3, reserved) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
